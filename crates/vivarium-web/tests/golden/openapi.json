  "components": {
    "schemas": {
      "ApiResponse_Page_User": {
        "type": "object",
        "description": "The unified response envelope.\n\n```\nuse vivarium_web::response::ApiResponse;\n\nlet body = ApiResponse::ok(serde_json::json!({ \"id\": 1 }));\nassert_eq!(body.code, 0);\nassert_eq!(body.message, \"ok\");\n```",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "`0` on success, otherwise the HTTP status code of the failure."
          },
          "data": {
            "type": "object",
            "description": "One page of results.",
            "required": [
              "items",
              "total",
              "page",
              "per_page"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "description": "The rows of this page."
              },
              "page": {
                "type": "integer",
                "format": "int32",
                "description": "The (normalized) page number this page represents.",
                "minimum": 0
              },
              "per_page": {
                "type": "integer",
                "format": "int32",
                "description": "The (normalized) page size.",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "format": "int64",
                "description": "Total number of matching rows across all pages.",
                "minimum": 0
              }
            }
          },
          "errors": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ValidationErrors",
                "description": "The validation violations; present only for a failed validation."
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "A short human-readable message; `\"ok\"` on success."
          }
        }
      },
      "ApiResponse_User": {
