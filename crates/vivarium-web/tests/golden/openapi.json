            "type": "string"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "One failed rule for one field.",
        "required": [
          "code",
          "params"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "The rule that failed (`\"length\"`, `\"email\"`, …)."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "The message the DTO declared for this rule, when it declared one."
          },
          "params": {
            "type": "object",
            "description": "The parameters of the failed rule (e.g. `{\"min\": 3, \"max\": 20}`).\n\nThe submitted field value is deliberately **not** echoed: `validator`\nrecords it as `params.value`, which would reflect raw input (a\npassword, a token) back to the client.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ValidationErrors": {
        "type": "object",
        "description": "Every violation, grouped by field.\n\nKeys are flattened field paths: `email` for a top-level field,\n`profile.email` for a nested struct field, `items[0].name` for a field of a\nlist element. The map is ordered, so the serialized body is stable.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/FieldViolation"
          }
        },
        "propertyNames": {
          "type": "string"
        }
      }
